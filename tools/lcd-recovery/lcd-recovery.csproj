<Project Sdk="Microsoft.NET.Sdk">

  <!-- Standalone panel-recovery utility. Kept out of AorusLcd.slnx on purpose, but
       CI builds it explicitly so it cannot bit-rot. Opts out of the repo
       Directory.Build.props so its top-level statements don't trip warnings-as-errors. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <ImportDirectoryBuildProps>false</ImportDirectoryBuildProps>
    <ImportDirectoryBuildTargets>false</ImportDirectoryBuildTargets>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\AorusLcd.Core\AorusLcd.Core.csproj" />
  </ItemGroup>

</Project>
